# ─── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Mail server identity (required for production email delivery) ────────────
# The fully-qualified hostname of your mail server.
# Must match the PTR (reverse-DNS) record your VPS provider sets for your IP.
MAIL_HOSTNAME=mail.yourdomain.com

# The domain emails will be sent FROM (e.g. yourdomain.com → noreply@yourdomain.com)
MAIL_DOMAIN=yourdomain.com

# ─── Optional overrides ───────────────────────────────────────────────────────
# DATABASE_URL=postgresql://graphrag:graphrag@db:5432/postgres?schema=public
# FRONTEND_URL=http://localhost:3100

# ─── SMTP (only needed if you want a different SMTP server) ───────────────────
# Defaults to the bundled smtp service (boky/postfix) at smtp:25.
# For local dev with Mailpit:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#
# SMTP_HOST=smtp
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
