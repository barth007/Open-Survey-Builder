# All variables below are required by docker-compose.yml unless marked optional.
# Copy to .env and fill in:  cp .env.example .env

# ─── Database (Postgres) ─────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=my_database

# ─── App ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=/api
VITE_API_URL=http://localhost:3001/api

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Brevo: https://app.brevo.com → Settings → SMTP & API → Generate SMTP key
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# Local dev with Mailpit (docker compose --profile dev up):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_USER=any  SMTP_PASS=any
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=any
SMTP_PASS=any
SMTP_FROM=noreply@localhost

# ─── Optional ────────────────────────────────────────────────────────────────
# SMTP_SECURE=false
# REDIS_URL=redis://redis:6379
