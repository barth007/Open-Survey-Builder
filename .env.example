# ─── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Brevo SMTP (transactional email) ────────────────────────────────────────
# Sign up at https://app.brevo.com → Settings → SMTP & API → Generate SMTP key
SMTP_USER=your-brevo-smtp-username
SMTP_PASS=your-brevo-smtp-key-here
SMTP_FROM=noreply@yourdomain.com

# ─── Optional overrides ───────────────────────────────────────────────────────
# DATABASE_URL=postgresql://graphrag:graphrag@db:5432/postgres?schema=public
# FRONTEND_URL=http://localhost:3100
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587

# ─── Local dev (Mailpit) ─────────────────────────────────────────────────────
# Run: docker compose --profile dev up
# Then override SMTP to point at Mailpit instead of Brevo:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=any
# SMTP_PASS=any
